namespace logs;

table LogMetadata {
  status:ushort;
  duration_ms:uint;
  bytes_sent:uint;
  user_agent:string;
  remote_addr:string;
}

table LogEntry {
  timestamp:string;
  level:string;
  message:string;
  request_id:string;
  metadata:LogMetadata;
}

table LogDataset {
  version:uint;
  domain:string;
  tier:string;
  entries:[LogEntry];
}

root_type LogDataset;
