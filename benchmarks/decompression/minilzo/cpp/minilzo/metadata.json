{
  "language": "C++",
  "implementation": "libminilzo",
  "timing": "internal",
  "run_cmd": "./bench {size}",
  "tags": [
    "cpp",
    "decompression",
    "minilzo"
  ],
  "hooks": {
    "install": "./install.sh",
    "build": "./build.sh",
    "clean": "rm -rf build bench"
  },
  "source_files": [
    "main.cpp",
    "CMakeLists.txt"
  ],
  "artifact_path": "bench",
  "dataset": {
    "root": "datasets/compression",
    "parameter": "{domain}/{tier}",
    "input": "payload.bin"
  },
  "notes": "Loads payload.bin once (untimed), compresses to minilzo wire bytes (untimed), then measures decompression only."
}
