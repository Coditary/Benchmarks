{
  "language": "C++",
  "implementation": "zlib",
  "timing": "internal",
  "run_cmd": "./bench {size}",
  "tags": [
    "cpp",
    "decompression",
    "zlib"
  ],
  "hooks": {
    "install": "./install.sh",
    "build": "./build.sh",
    "clean": "rm -rf build bench"
  },
  "source_files": [
    "main.cpp",
    "CMakeLists.txt"
  ],
  "artifact_path": "bench",
  "dataset": {
    "root": "datasets/fixtures/compression",
    "parameter": "{domain}/{tier}",
    "input": "fixture.bin"
  },
  "notes": "Loads zlib fixture once (untimed), then measures decompression."
}
