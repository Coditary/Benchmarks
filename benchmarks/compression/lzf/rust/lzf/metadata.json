{
  "language": "Rust",
  "implementation": "lzf",
  "timing": "internal",
  "run_cmd": "./bench {size}",
  "tags": [
    "rust",
    "compression",
    "lzf"
  ],
  "hooks": {
    "install": "./install.sh",
    "build": "cargo build --release && cp target/release/compression-lzf ./bench",
    "clean": "cargo clean && rm -f bench"
  },
  "source_files": [
    "src/main.rs",
    "Cargo.toml"
  ],
  "artifact_path": "bench",
  "dataset": {
    "root": "datasets/compression",
    "parameter": "{domain}/{tier}",
    "input": "payload.bin"
  },
  "notes": "Loads payload.bin once (untimed), then measures compression only."
}
