{
  "language": "Rust",
  "implementation": "msgpacker",
  "timing": "internal",
  "run_cmd": "./bench {size}",
  "tags": ["rust", "messagepack", "binary"],
  "hooks": {
    "install": "./install.sh",
    "build": "cargo build --release && cp target/release/messagepack-serialize-msgpacker ./bench",
    "clean": "cargo clean && rm -f bench"
  },
  "source_files": ["src/main.rs", "Cargo.toml"],
  "artifact_path": "bench",
  "notes": "msgpacker native encode after untimed conversion from canonical log dataset."
}
