{
  "language": "C++",
  "implementation": "protobuf-cpp",
  "timing": "internal",
  "run_cmd": "./bench {size}",
  "tags": [
    "cpp",
    "protobuf",
    "binary"
  ],
  "hooks": {
    "install": "./install.sh",
    "build": "./build.sh",
    "clean": "rm -rf build bench"
  },
  "source_files": [
    "main.cpp",
    "convert.cpp",
    "convert.hpp",
    "CMakeLists.txt"
  ],
  "artifact_path": "bench",
  "dataset": {
    "root": "datasets/shared",
    "parameter": "{domain}/{tier}",
    "input": "canonical.json"
  },
  "notes": "Canonical dataset to protobuf message (untimed), then timed SerializeToString."
}
