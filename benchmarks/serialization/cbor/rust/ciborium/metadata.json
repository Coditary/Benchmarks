{
  "language": "Rust",
  "implementation": "ciborium",
  "timing": "internal",
  "run_cmd": "./bench {size}",
  "tags": [
    "rust",
    "serialize",
    "cbor",
    "binary",
    "document"
  ],
  "hooks": {
    "install": "./install.sh",
    "build": "cargo build --release && cp target/release/cbor-serialize-ciborium ./bench",
    "clean": "cargo clean && rm -f bench"
  },
  "source_files": [
    "src/main.rs",
    "Cargo.toml"
  ],
  "artifact_path": "bench",
  "dataset": {
    "root": "datasets/shared",
    "parameter": "{domain}/{tier}",
    "input": "canonical.json"
  },
  "notes": "CBOR encode from canonical dataset (untimed load, timed serialize)."
}
