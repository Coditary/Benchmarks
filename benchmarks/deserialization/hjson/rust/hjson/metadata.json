{
  "language": "Rust",
  "implementation": "hjson",
  "timing": "internal",
  "run_cmd": "./bench {size}",
  "tags": [
    "rust",
    "deserialize",
    "hjson",
    "text",
    "config"
  ],
  "hooks": {
    "install": "./install.sh",
    "build": "cargo build --release && cp target/release/hjson-deserialize ./bench",
    "clean": "cargo clean && rm -f bench"
  },
  "source_files": [
    "src/main.rs",
    "Cargo.toml"
  ],
  "artifact_path": "bench",
  "dataset": {
    "root": "datasets/fixtures",
    "parameter": "{domain}/{tier}",
    "input": "fixture.bin"
  },
  "notes": "Loads pre-generated wire fixture once (untimed), then measures parse + materialization."
}
