{
  "language": "C++",
  "implementation": "kdl-cpp",
  "timing": "internal",
  "run_cmd": "./bench {size}",
  "tags": [
    "cpp",
    "deserialize",
    "kdl",
    "text",
    "config"
  ],
  "hooks": {
    "install": "./install.sh",
    "build": "./build.sh",
    "clean": "rm -rf build bench"
  },
  "source_files": [
    "main.cpp",
    "CMakeLists.txt"
  ],
  "artifact_path": "bench",
  "dataset": {
    "root": "datasets/fixtures",
    "parameter": "{domain}/{tier}",
    "input": "fixture.bin"
  },
  "notes": "C++ KDL parse from wire fixture."
}
